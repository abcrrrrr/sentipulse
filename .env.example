# Reddit — create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:sentipulse:0.1 (by /u/your_username)

# Anthropic — only needed for the Claude quality sample (scorer=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# X / Twitter — optional, pay-per-use (~$0.005 per post read). Leave blank to disable.
X_BEARER_TOKEN=
X_DAILY_READ_BUDGET=500

# Storage
SENTIPULSE_DB=data/sentipulse.duckdb
